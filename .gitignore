.env
.venv/
__pycache__/
*.pyc
# data/chroma/ is deliberately NOT ignored. It holds the persisted ChromaDB
# store that the app reads at query time. Streamlit Community Cloud has no build
# step in which to ingest into it and its filesystem is ephemeral, so the store
# ships in the repo and the deploy reads exactly the store built here.
# Rebuild it only when the corpus changes: python -m src.ingest --force
.streamlit/secrets.toml
logs/
# Screenshots written by scripts/check_ui_*.py during a UI review. Local
# artefacts, regenerated on demand, not source.
.ui-review-*.png
# Regenerable verbose embedding dump (all 384 dims for all 177 chunks, ~1 MB).
# The readable digest data/chunks/embeddings_preview.txt is tracked instead.
data/chunks/embeddings_full.txt
